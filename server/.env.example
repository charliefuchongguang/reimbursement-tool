# ── 服务端口 ──
PORT=3000

# ── JWT 签名密钥（生产环境必须改成足够长的随机字符串）──
JWT_SECRET=change-me-to-a-long-random-secret

# ── 管理员账号（启动时自动播种）──
# 管理员手机号（11 位）；不填则跳过管理员播种
ADMIN_PHONE=13800000000
# 管理员初始密码；不填则默认为手机号后六位
ADMIN_PASSWORD=
# 管理员昵称
ADMIN_NICKNAME=管理员

# ── 数据库文件路径（默认 ./data/app.db）──
DB_PATH=./data/app.db

# ── 默认大模型配置（管理员可在页面内修改）──
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
# 统一 API Key 建议通过管理员页面写入数据库，也可在此预置
DEFAULT_LLM_API_KEY=